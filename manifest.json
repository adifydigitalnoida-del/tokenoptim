{
  "manifest_version": 3,
  "name": "TokenOptim",
  "version": "3.1.0",
  "description": "Real-time token counting + semantic caching for Claude, ChatGPT, Gemini, Grok, Kimi, GLM. Save 60-90% on AI costs.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://kimi.moonshot.ai/*",
    "https://glm.cn/*"
  ],
  "action": {
    "default_title": "TokenOptim - Token Counter & Caching",
    "default_popup": "popup.html",
    "default_icons": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://kimi.moonshot.ai/*",
        "https://glm.cn/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
